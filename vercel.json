{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/propietarios",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/experiences",
      "destination": "/journeys",
      "permanent": true
    },
    {
      "source": "/experiences/:path*",
      "destination": "/journeys/:path*",
      "permanent": true
    },
    {
      "source": "/houses",
      "destination": "/homes",
      "permanent": true
    },
    {
      "source": "/houses/:path*",
      "destination": "/homes/:path*",
      "permanent": true
    },
    {
      "source": "/homes/:slug",
      "destination": "/homes",
      "permanent": false
    }
  ]
}
